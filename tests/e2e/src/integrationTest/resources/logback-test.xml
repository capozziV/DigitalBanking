<!--
  The end-to-end tests are plain JUnit: without a logging backend, SLF4J falls back to no-op and the LocalStack output
  that LocalStackTestSupport forwards (the evidence of a startup timeout) never reaches the test report.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="localstack" level="INFO"/>
    <logger name="tc" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
