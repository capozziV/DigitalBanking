auth {
  mode: bearer
}

auth:bearer {
  token: {{customerToken}}
}

script:pre-request {
  // Variante do script das colecoes accounts, notification, statement e transfers (copias identicas entre si):
  // o pedido de token (userToken) e o mesmo, mude-o junto com elas.
  // Tokens do mock-oauth2-server (como infra/local/auth/token.sh), uma vez por execucao da colecao: um cliente novo,
  // ainda sem cadastro (customerToken, o token padrao das requisicoes, por heranca), e o usuario de teste do dono no
  // grupo admin (adminToken).
  if (!bru.getVar("customerToken")) {
    const axios = require("axios");
    const tokenUrl = bru.getEnvVar("tokenUrl");
    async function userToken(sub, admin) {
      // Formulario montado a mao: o sandbox de scripts do Bruno nao tem URLSearchParams.
      const form = `grant_type=password&username=${encodeURIComponent(sub)}&password=unused` +
        (admin ? "&user_groups=admin" : "");
      const r = await axios.post(tokenUrl, form, {
        auth: { username: "web", password: "local-secret" },
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
      });
      return r.data.access_token;
    }
    const sub = bru.interpolate("{{$guid}}");
    bru.setVar("customerId", sub);
    // Telefones unicos por execucao: o cadastro, a troca e a busca usam os mesmos valores. O "+" vai como %2B na URL.
    const digits = () => String(Math.floor(Math.random() * 100000000)).padStart(8, "0");
    bru.setVar("customerPhone", "+55119" + digits());
    bru.setVar("customerNewPhone", "+55119" + digits());
    bru.setVar("customerNewPhoneEncoded", encodeURIComponent(bru.getVar("customerNewPhone")));
    bru.setVar("adminToken", await userToken(bru.getEnvVar("adminSub"), true));
    bru.setVar("customerToken", await userToken(sub, false));
  }
}
