meta {
  name: Cadastro com telefone invalido
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/customers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Bruno Customer",
    "email": "bruno-invalido@example.test",
    "phone": "11987654321"
  }
}

tests {
  test("400 validation-error no campo phone (celular E.164, +55DD9XXXXXXXX)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.type).to.contain("validation-error");
    expect(res.body.errors.map((e) => e.field)).to.deep.equal(["phone"]);
  });
}
