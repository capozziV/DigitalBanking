meta {
  name: Consultar pelo admin
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/admin/customers/{{customerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("200 com o cadastro", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("customerId"));
  });
}
