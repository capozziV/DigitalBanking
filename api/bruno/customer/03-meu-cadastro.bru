meta {
  name: Meu cadastro
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/customers/me
  body: none
  auth: inherit
}

tests {
  test("200 com o cadastro do cliente do token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("customerId"));
    expect(res.body.name).to.equal("Bruno Customer");
  });
}
