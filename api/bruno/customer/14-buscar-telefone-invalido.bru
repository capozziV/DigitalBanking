meta {
  name: Buscar telefone invalido
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/customers/lookup?phone=11987654321
  body: none
  auth: inherit
}

tests {
  test("400 validation-error no campo phone", function () {
    expect(res.status).to.equal(400);
    expect(res.body.type).to.contain("validation-error");
    expect(res.body.errors.map((e) => e.field)).to.deep.equal(["phone"]);
  });
}
