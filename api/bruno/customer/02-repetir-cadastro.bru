meta {
  name: Repetir cadastro
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/customers
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno Customer",
    "email": "bruno-{{customerId}}@example.test"
  }
}

tests {
  test("200 com o mesmo cadastro (idempotente pelo sub)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("customerId"));
  });
}
