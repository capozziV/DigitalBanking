meta {
  name: Trocar telefone
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/customers/me/phone
  body: json
  auth: inherit
}

body:json {
  {
    "phone": "{{customerNewPhone}}"
  }
}

tests {
  test("200 com o telefone novo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("customerId"));
    expect(res.body.phone).to.equal(bru.getVar("customerNewPhone"));
  });
}
