meta {
  name: Abrir conta
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accounts
  body: none
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

script:post-response {
  bru.setVar("accountId", res.body.id);
}

tests {
  // O cliente vem do token (customerToken, cadastrado no customer pelo script da colecao), nao do corpo.
  test("201 com a conta nova do cliente do token", function () {
    expect(res.status).to.equal(201);
    expect(res.body.balance).to.equal(0);
    expect(res.body.customerId).to.equal(bru.getVar("customerId"));
  });
}
