meta {
  name: Esvaziar conta
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/accounts/{{accountId}}/debits
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "amount": 10700,
    "description": "esvazia a conta antes de encerrar"
  }
}

tests {
  // Saldo da colecao ate aqui: +10000 (bonus) +1000 (03) e -300 (04) = 10700 (o credito do cliente em 11 e recusado com 403); zera a conta para o encerramento (15).
  test("201 com o lancamento de debito", function () {
    expect(res.status).to.equal(201);
    expect(res.body.kind).to.equal("DEBIT");
  });
}
