meta {
  name: Conta de outro cliente
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/accounts/{{accountId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherCustomerToken}}
}

tests {
  test("404 account-not-found, sem revelar que a conta existe", function () {
    expect(res.status).to.equal(404);
    expect(res.body.type).to.contain("account-not-found");
  });
}
