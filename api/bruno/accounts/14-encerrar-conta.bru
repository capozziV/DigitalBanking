meta {
  name: Encerrar conta
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/accounts/{{accountId}}/close
  body: none
  auth: inherit
}

tests {
  // Exige saldo zero e nenhuma transferencia pendente; com saldo, 422 balance-not-zero.
  test("200 com a conta CLOSED, ou 422 se ainda ha saldo", function () {
    expect([200, 422]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.status).to.equal("CLOSED");
    }
  });
}
