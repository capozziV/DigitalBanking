meta {
  name: Bloquear conta
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/admin/accounts/{{accountId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "BLOCKED"
  }
}

tests {
  test("200 com a conta BLOCKED", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("BLOCKED");
  });
}
