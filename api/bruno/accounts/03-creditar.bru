meta {
  name: Creditar
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/accounts/{{accountId}}/credits
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{creditKey}}
}

script:pre-request {
  bru.setVar("creditKey", "bruno-credit-" + Date.now());
}

body:json {
  {
    "amount": 1000,
    "description": "credito pela colecao Bruno"
  }
}

tests {
  test("201 com o lancamento", function () {
    expect(res.status).to.equal(201);
    expect(res.body.kind).to.equal("CREDIT");
  });
}
