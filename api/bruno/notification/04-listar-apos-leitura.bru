meta {
  name: Listar apos a leitura
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/notifications?customerId={{sourceCustomerId}}
  body: none
  auth: none
}

tests {
  test("nenhuma notificacao nao lida", function () {
    expect(res.status).to.equal(200);
    expect(res.body.unreadCount).to.equal(0);
  });
}
