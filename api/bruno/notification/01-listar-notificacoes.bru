meta {
  name: Listar notificacoes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/notifications
  body: none
  auth: inherit
}

script:pre-request {
  // Gera os eventos: o cliente (remetente) e o outro cliente (destinatario) abrem uma conta cada, o admin credita a
  // origem e o remetente transfere; depois espera a notificacao chegar (ate 45 s). O token diz de quem sao as
  // notificacoes listadas.
  const axios = require("axios");
  const base = bru.getEnvVar("baseUrl");
  const guid = () => bru.interpolate("{{$guid}}");
  const bearer = (name) => ({ Authorization: `Bearer ${bru.getVar(name)}` });
  async function openAccount(tokenVar) {
    const r = await axios.post(`${base}/accounts`, null,
      { headers: { ...bearer(tokenVar), "Idempotency-Key": guid() } });
    return r.data.id;
  }
  const source = await openAccount("customerToken");
  const destination = await openAccount("otherCustomerToken");
  await axios.post(`${base}/accounts/${source}/credits`, { amount: 1000, description: "bruno credito" },
    { headers: { ...bearer("adminToken"), "Idempotency-Key": guid() } });
  await axios.post(`${base}/transfers`,
    { sourceAccountId: source, destinationAccountId: destination, amount: 300, description: "bruno transferencia" },
    { headers: { ...bearer("customerToken"), "Idempotency-Key": guid() } });

  for (let i = 0; i < 45; i++) {
    const r = await axios.get(`${base}/notifications`, { headers: bearer("customerToken") });
    if (r.data.items.some((n) => n.kind === "TRANSFER_SENT")) break;
    await new Promise((resolve) => setTimeout(resolve, 1000));
    if (i === 44) throw new Error("FALHA: TRANSFER_SENT nao chegou em 45 s");
  }
}

script:post-response {
  if (res.body.items && res.body.items.length > 0) {
    bru.setVar("latestNotificationId", res.body.items[0].id);
  }
}

tests {
  test("200 com TRANSFER_SENT nao lida para o remetente", function () {
    expect(res.status).to.equal(200);
    const kinds = res.body.items.map((n) => n.kind);
    expect(kinds).to.include("TRANSFER_SENT");
    expect(res.body.unreadCount).to.be.above(0);
  });

  test("data.amountCents da TRANSFER_SENT e numero (centavos)", function () {
    const sent = res.body.items.find((n) => n.kind === "TRANSFER_SENT");
    expect(sent.data.amountCents).to.equal(300);
  });
}
