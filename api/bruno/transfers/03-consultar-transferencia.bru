meta {
  name: Consultar transferencia
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/transfers/{{transferId}}
  body: none
  auth: inherit
}

tests {
  test("200 com a transferencia", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("transferId"));
    expect(res.body).to.have.property("status");
  });
}
