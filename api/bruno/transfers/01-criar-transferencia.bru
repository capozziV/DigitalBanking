meta {
  name: Criar transferencia
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{transferKey}}
}

body:json {
  {
    "sourceAccountId": "{{sourceAccountId}}",
    "destinationAccountId": "{{destinationAccountId}}",
    "amount": 300,
    "description": "bruno transferencia"
  }
}

script:pre-request {
  // A chave fica guardada para a requisicao 02 repetir exatamente a mesma.
  const axios = require("axios");
  bru.setVar("transferKey", bru.interpolate("{{$guid}}"));

  // Abre a origem do cliente (com saldo 1000, credito do admin) e o destino de outro cliente pelo accounts,
  // para a colecao rodar sozinha. A transferencia vai com o token do cliente da origem (heranca da colecao).
  const base = bru.getEnvVar("baseUrl");
  const bearer = (name) => ({ Authorization: `Bearer ${bru.getVar(name)}` });
  async function openAccount(tokenVar) {
    const r = await axios.post(`${base}/accounts`, null,
      { headers: { ...bearer(tokenVar), "Idempotency-Key": bru.interpolate("{{$guid}}") } });
    return r.data.id;
  }
  const source = await openAccount("customerToken");
  const destination = await openAccount("otherCustomerToken");
  await axios.post(`${base}/accounts/${source}/credits`, { amount: 1000, description: "bruno credito" },
    { headers: { ...bearer("adminToken"), "Idempotency-Key": bru.interpolate("{{$guid}}") } });
  bru.setVar("sourceAccountId", source);
  bru.setVar("destinationAccountId", destination);
}

script:post-response {
  bru.setVar("transferId", res.body.id);
}

tests {
  // 201 se a saga terminou na propria requisicao; 202 se o agendador tomou a transferencia antes (ainda PENDING).
  test("201 ou 202 com a transferencia criada", function () {
    expect(res.status).to.be.oneOf([201, 202]);
    expect(res.body.status).to.equal(res.status === 201 ? "COMPLETED" : "PENDING");
    expect(res.body.amount).to.equal(300);
    expect(res.headers["location"]).to.contain("/transfers/");
  });
}
