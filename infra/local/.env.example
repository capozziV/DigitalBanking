# Valores apenas para desenvolvimento local.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
ACCOUNTS_DB_OWNER_PASSWORD=accounts_owner
ACCOUNTS_DB_PASSWORD=accounts_app
TRANSFERS_DB_OWNER_PASSWORD=transfers_owner
TRANSFERS_DB_PASSWORD=transfers_app
NOTIFICATION_DB_OWNER_PASSWORD=notification_owner
NOTIFICATION_DB_PASSWORD=notification_app
REDIS_PORT=6379
NGINX_PORT=80
LOCALSTACK_PORT=4566

# Obrigatoria para o LocalStack (SNS e SQS): token da conta Hobby gratuita em app.localstack.cloud.
# Preencha so no seu .env (fora do git); sem ela o conteiner do LocalStack encerra na partida.
LOCALSTACK_AUTH_TOKEN=

# Lidas pelos servicos accounts, transfers e notification (jar ou bootRun), nao pelo compose.
# Os nomes dos roles sao fixos no script de init do PostgreSQL (postgres/init).
# Se mudar POSTGRES_PORT, ajuste a porta em ACCOUNTS_DB_URL.
ACCOUNTS_DB_URL=jdbc:postgresql://localhost:5432/accounts
ACCOUNTS_DB_USER=accounts_app
ACCOUNTS_DB_OWNER_USER=accounts_owner
# Se mudar LOCALSTACK_PORT, ajuste a porta em ACCOUNTS_AWS_ENDPOINT.
ACCOUNTS_AWS_ENDPOINT=http://localhost:4566

# transfers: banco proprio e URL do accounts (chamado direto, sem passar pelo nginx).
# Se mudar POSTGRES_PORT, ajuste a porta em TRANSFERS_DB_URL.
TRANSFERS_DB_URL=jdbc:postgresql://localhost:5432/transfers
TRANSFERS_DB_USER=transfers_app
TRANSFERS_DB_OWNER_USER=transfers_owner
TRANSFERS_ACCOUNTS_URL=http://localhost:8081
# Opcionais (os padroes valem para o LocalStack local); TRANSFERS_AWS_ENDPOINT vazio usa o endpoint real da AWS.
# Se mudar LOCALSTACK_PORT, ajuste a porta em TRANSFERS_AWS_ENDPOINT.
TRANSFERS_AWS_ENDPOINT=http://localhost:4566
# TRANSFERS_AWS_REGION=us-east-1
# TRANSFERS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:transfers-events.fifo
TRANSFERS_REDIS_HOST=localhost
TRANSFERS_REDIS_PORT=6379
# TRANSFERS_REDIS_TIMEOUT=100ms
# TRANSFERS_DAILY_LIMIT=500000

# notification: banco proprio e filas (consome notification-accounts.fifo e notification-transfers.fifo).
# Se mudar POSTGRES_PORT, ajuste a porta em NOTIFICATION_DB_URL.
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_OWNER_USER=notification_owner
# Obrigatoria para usar o LocalStack: sem ela (ou vazia), o notification usa o endpoint real da AWS.
# Se mudar LOCALSTACK_PORT, ajuste a porta em NOTIFICATION_AWS_ENDPOINT.
NOTIFICATION_AWS_ENDPOINT=http://localhost:4566
# Lidas pelo compose ao criar as filas do notification no LocalStack (padroes 5 e 30).
# NOTIFICATION_MAX_RECEIVE_COUNT=5
# NOTIFICATION_VISIBILITY_TIMEOUT_SECONDS=30

# statement: tabela DynamoDB statement e fila statement-accounts.fifo no LocalStack (sem banco relacional).
# Endpoint vazio usa o endpoint real da AWS. Se mudar LOCALSTACK_PORT, ajuste a porta.
STATEMENT_AWS_ENDPOINT=http://localhost:4566
# Cache da primeira pagina do extrato (Redis do compose, a mesma porta de REDIS_PORT).
STATEMENT_REDIS_HOST=localhost
STATEMENT_REDIS_PORT=6379
# Tempo maximo de conexao e de comando ao Redis; estourou, o extrato le do DynamoDB.
# STATEMENT_CACHE_TIMEOUT=100ms
# false troca o cache por um que nunca guarda nada (valvula de operacao; padrao true).
# STATEMENT_CACHE_ENABLED=true
# Lidas pelo compose ao criar a fila do statement no LocalStack (padroes 5 e 30).
# STATEMENT_MAX_RECEIVE_COUNT=5
# STATEMENT_VISIBILITY_TIMEOUT_SECONDS=30

# Identidade local: mock-oauth2-server (compose), no lugar do Cognito. Emissor http://localhost:8090/default.
# Se mudar MOCK_OAUTH2_PORT, ajuste a porta nos *_JWT_ISSUER_URI e em MOCK_OAUTH2_URL (auth/token.sh).
MOCK_OAUTH2_PORT=8090
# MOCK_OAUTH2_URL=http://localhost:8090/default
# Lidas pelos servicos (jar ou bootRun), nao pelo compose. Todos validam o JWT pelo emissor.
ACCOUNTS_JWT_ISSUER_URI=http://localhost:8090/default
TRANSFERS_JWT_ISSUER_URI=http://localhost:8090/default
NOTIFICATION_JWT_ISSUER_URI=http://localhost:8090/default
STATEMENT_JWT_ISSUER_URI=http://localhost:8090/default
CUSTOMER_JWT_ISSUER_URI=http://localhost:8090/default
# Clientes de maquina (client credentials, escopo digitalbanking/internal) dos servicos que chamam outros:
# accounts e transfers chamam o customer; transfers chama o accounts. O mock aceita qualquer segredo (so dev local).
ACCOUNTS_OAUTH_CLIENT_ID=accounts
ACCOUNTS_OAUTH_CLIENT_SECRET=local-secret
TRANSFERS_OAUTH_CLIENT_ID=transfers
TRANSFERS_OAUTH_CLIENT_SECRET=local-secret
