# Valores apenas para desenvolvimento local.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
ACCOUNTS_DB_OWNER_PASSWORD=accounts_owner
ACCOUNTS_DB_PASSWORD=accounts_app
REDIS_PORT=6379
NGINX_PORT=80

# Lidas pelo servico accounts (jar ou bootRun), nao pelo compose.
# Os nomes dos roles sao fixos no script de init do PostgreSQL (postgres/init).
# Se mudar POSTGRES_PORT, ajuste a porta em ACCOUNTS_DB_URL.
ACCOUNTS_DB_URL=jdbc:postgresql://localhost:5432/accounts
ACCOUNTS_DB_USER=accounts_app
ACCOUNTS_DB_OWNER_USER=accounts_owner
