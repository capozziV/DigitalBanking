{
  "_comment": "Topicos SNS FIFO, filas SQS FIFO e DLQs, espelho de infra/local/localstack/init/ready.d. Conferido por envs/aws/check-messaging.py. As filas *-inspection.fifo existem so no LocalStack (sem consumidor) e ficam fora.",
  "visibility_timeout_seconds": 30,
  "max_receive_count": 5,
  "_comment_max_receive_count": "Padrao das filas de consumo. A statement-accounts.fifo tem o proprio max_receive_count (120 x 30 s, cerca de 1 h antes da DLQ, #239).",
  "topics": [
    { "name": "accounts-events.fifo", "fifo": true },
    { "name": "transfers-events.fifo", "fifo": true },
    { "name": "customer-events.fifo", "fifo": true }
  ],
  "queues": [
    { "name": "notification-accounts.fifo", "fifo": true, "dlq": "notification-accounts-dlq.fifo", "topic": "accounts-events.fifo" },
    { "name": "notification-transfers.fifo", "fifo": true, "dlq": "notification-transfers-dlq.fifo", "topic": "transfers-events.fifo" },
    { "name": "notification-customer.fifo", "fifo": true, "dlq": "notification-customer-dlq.fifo", "topic": "customer-events.fifo" },
    { "name": "statement-accounts.fifo", "fifo": true, "dlq": "statement-accounts-dlq.fifo", "topic": "accounts-events.fifo", "max_receive_count": 120 }
  ],
  "dead_letter_queues": [
    { "name": "notification-accounts-dlq.fifo", "fifo": true },
    { "name": "notification-transfers-dlq.fifo", "fifo": true },
    { "name": "notification-customer-dlq.fifo", "fifo": true },
    { "name": "statement-accounts-dlq.fifo", "fifo": true }
  ],
  "dynamodb_tables": [
    { "name": "statement", "hash_key": { "name": "accountId", "type": "S" }, "range_key": { "name": "sequence", "type": "N" } }
  ]
}
